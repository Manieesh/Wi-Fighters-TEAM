# ==============================================================
# PROMETHEUS — Unified Government Integration Platform
# Environment Variables Reference
# ==============================================================
# NOTE: Never commit sensitive credentials or actual secrets.
# Populate these variables in your Vercel Project Settings or local .env files.

# --------------------------------------------------------------
# 1. Prometheus Backend (Node.js Express / MongoDB)
# --------------------------------------------------------------
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=PrometheusDB
ALLOWED_ORIGINS=https://your-domain.vercel.app

# Injected automatically at runtime by Vercel Service Bindings:
# RTO_BACKEND_URL=

# --------------------------------------------------------------
# 2. RTO Backend (FastAPI / Supabase)
# --------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
ALLOWED_ORIGINS=https://your-domain.vercel.app

# --------------------------------------------------------------
# 3. Prometheus Frontend (Vite / React)
# --------------------------------------------------------------
# Optional overrides (defaults to same-domain relative paths in production)
VITE_API_URL=/api
VITE_VOTER_PORTAL_URL=/voter
VITE_RTO_PORTAL_URL=/rto
VITE_WELFARE_PORTAL_URL=/welfare
VITE_OFFICER_PORTAL_URL=/officer

# --------------------------------------------------------------
# 4. Officer Portal (Vite / React)
# --------------------------------------------------------------
VITE_API_URL=/api
VITE_CITIZEN_PORTAL_URL=/

# --------------------------------------------------------------
# 5. RTO Frontend (Vite / React)
# --------------------------------------------------------------
VITE_API_BASE_URL=/rto-api
VITE_PROMETHEUS_API_URL=/api

# --------------------------------------------------------------
# 6. Welfare Portal (Vite / React)
# --------------------------------------------------------------
VITE_API_URL=/api

# --------------------------------------------------------------
# 7. Voter Portal (Vite / React)
# --------------------------------------------------------------
VITE_API_URL=/api
